# ============================================================
# TienditaCampus - Configuracion base del monorepo actual
# ============================================================

# Frontend (Next.js raiz)
NEXT_PUBLIC_API_URL=/api
BACKEND_PROXY_URL=http://localhost:3001/api

# Backend (NestJS)
NODE_ENV=development
BACKEND_PORT=3001
FRONTEND_URL=http://localhost:3000,http://localhost:8080
JWT_SECRET=replace-with-a-secure-random-secret
JWT_EXPIRATION=7d

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tienditacampus
POSTGRES_USER=tc_admin
POSTGRES_PASSWORD=replace-with-a-secure-password
POSTGRES_SYNCHRONIZE=false

# Argon2
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# SMTP (opcional; si falta, el backend hace fallback a consola)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="TienditaCampus <noreply@tienditacampus.com>"
