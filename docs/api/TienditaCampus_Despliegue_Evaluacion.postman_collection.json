        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Producto Demo {{timestamp}}\",\n  \"description\": \"Producto creado desde Postman para evaluacion\",\n  \"unitCost\": 10,\n  \"salePrice\": 18,\n  \"isPerishable\": false,\n  \"categoryId\": \"{{category_id}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/products",
          "host": [
            "{{base_url}}"
          ],
          "path": [
