# ============================================================
# TienditaCampus - Frontend (Next.js 14 PWA)
# ============================================================
# Los valores se heredan del .env raíz via docker-compose
# Para desarrollo local sin Docker, configura los valores aquí
# ============================================================

NEXT_PUBLIC_API_URL=/api
# URL real del backend consumida por el proxy server-side de Next.js
BACKEND_PROXY_URL=http://localhost:3001/api

# Origenes permitidos por el backend (CORS)
FRONTEND_URL=http://localhost:3000,http://localhost:8080

# SMTP opcional. Si no se define, el backend usa fallback a consola para 2FA.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="TienditaCampus <noreply@tienditacampus.com>"
