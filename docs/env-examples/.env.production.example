# ============================================================
# TienditaCampus - Frontend Production Environment Config
# ============================================================

# URL pública de la instancia EC2 o nombre de dominio
NEXT_PUBLIC_API_URL=/api
# Endpoint backend (AWS, ECS, API Gateway, etc.) para proxy server-side
BACKEND_PROXY_URL=https://api.tu-dominio.com/api

# Origen del frontend desplegado
FRONTEND_URL=https://tu-dominio.com

# SMTP opcional para 2FA por correo
SMTP_HOST=smtp.tu-proveedor.com
SMTP_PORT=587
SMTP_USER=usuario_smtp
SMTP_PASS=secret_smtp
SMTP_FROM="TienditaCampus <noreply@tu-dominio.com>"
