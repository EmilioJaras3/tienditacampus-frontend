{
  "info": {
    "name": "TienditaCampus - FULL PRODUCTION 2026",
    "description": "Colección DEFINITIVA para probar TienditaCampus en Producción.\nServidor: http://44.194.142.223:3001\n\nIMPORTANTE: Seguir el flujo de Autenticación para llenar la variable {{token}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. System",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/health", "host": ["{{base_url}}"], "path": ["health"] }
          }
        }
      ]
    },
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"testuser@upchiapas.edu.mx\",\n  \"password\": \"Password123!\",\n  \"firstName\": \"Carlos\",\n  \"lastName\": \"González\",\n  \"role\": \"seller\",\n  \"campusLocation\": \"UD1\",\n  \"major\": \"ITI\",\n  \"acceptTerms\": true\n}"
            },
            "url": { "raw": "{{base_url}}/auth/register", "host": ["{{base_url}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "Login Step 1 (Send 2FA)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"testuser@upchiapas.edu.mx\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Verify 2FA",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.accessToken) { pm.environment.set('token', j.accessToken); pm.environment.set('my_user_id', j.user.id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"testuser@upchiapas.edu.mx\",\n  \"code\": \"123456\"\n}"
            },
            "url": { "raw": "{{base_url}}/auth/verify-2fa", "host": ["{{base_url}}"], "path": ["auth", "verify-2fa"] }
          }
        },
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/auth/profile", "host": ["{{base_url}}"], "path": ["auth", "profile"] }
          }
        }
      ]
    },
    {
      "name": "2. Products",
      "item": [
        {
          "name": "Marketplace (Public)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/products/marketplace?page=1&limit=20", "host": ["{{base_url}}"], "path": ["products", "marketplace"], "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "20" }] }
          }
        },
        {
          "name": "Create Product",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Brownies\",\n  \"description\": \"Hechos en casa\",\n  \"category\": \"Snacks\",\n  \"unitCost\": 10,\n  \"sellingPrice\": 25,\n  \"unit\": \"pieza\"\n}"
            },
            "url": { "raw": "{{base_url}}/products", "host": ["{{base_url}}"], "path": ["products"] }
          }
        },
        {
          "name": "List My Products (Seller)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/products", "host": ["{{base_url}}"], "path": ["products"] }
          }
        }
      ]
    },
    {
      "name": "3. Inventory",
      "item": [
        {
          "name": "Add Stock",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{product_id}}\",\n  \"quantity\": 20,\n  \"unitCost\": 10,\n  \"expiresAt\": \"2026-12-31T23:59:59Z\"\n}"
            },
            "url": { "raw": "{{base_url}}/inventory", "host": ["{{base_url}}"], "path": ["inventory"] }
          }
        }
      ]
    },
    {
      "name": "4. Orders",
      "item": [
        {
          "name": "Solicitar Compra (Purchase)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sellerId\": \"{{seller_id}}\",\n  \"items\": [{ \"productId\": \"{{product_id}}\", \"quantity\": 1 }],\n  \"deliveryMessage\": \"En el domo\"\n}"
            },
            "url": { "raw": "{{base_url}}/orders/purchase", "host": ["{{base_url}}"], "path": ["orders", "purchase"] }
          }
        },
        {
          "name": "Seller: Accept Order",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/orders/{{order_id}}/accept", "host": ["{{base_url}}"], "path": ["orders", "{{order_id}}", "accept"] }
          }
        },
        {
          "name": "Seller: Deliver Order",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/orders/{{order_id}}/deliver", "host": ["{{base_url}}"], "path": ["orders", "{{order_id}}", "deliver"] }
          }
        }
      ]
    },
    {
      "name": "5. Finance & Reports",
      "item": [
        {
          "name": "Dashboard Comparison",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/dashboard/comparison", "host": ["{{base_url}}"], "path": ["dashboard", "comparison"] }
          }
        },
        {
          "name": "Generate Weekly Report",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/reports/weekly/generate", "host": ["{{base_url}}"], "path": ["reports", "weekly", "generate"] }
          }
        }
      ]
    },
    {
      "name": "6. Audit",
      "item": [
        {
          "name": "Recent Activity",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/audit/recent?limit=50", "host": ["{{base_url}}"], "path": ["audit", "recent"], "query": [{ "key": "limit", "value": "50" }] }
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "base_url", "value": "http://44.194.142.223:3001/api" },
    { "key": "token", "value": "" },
    { "key": "product_id", "value": "" },
    { "key": "seller_id", "value": "" },
    { "key": "order_id", "value": "" }
  ]
}
